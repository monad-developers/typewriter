{
  "name": "typewriter-evm",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "napi": {
    "binaryName": "typewriter-evm"
  },
  "scripts": {
    "benchmark": "bun run build && bun test ./test/*.benchmark.ts",
    "build": "napi build --release --output-dir native",
    "build:debug": "napi build --output-dir native",
    "lint:effect": "effect-language-service diagnostics --project tsconfig.json",
    "test": "bun run build:debug && bun test",
    "typecheck": "tsc --noEmit",
    "lint": "cargo fmt --check && cargo clippy -- -D warnings && forge fmt --check test/contracts"
  },
  "dependencies": {
    "effect": "catalog:",
    "ox": "catalog:"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@napi-rs/cli": "3.6.2",
    "prool": "catalog:",
    "solmate": "github:transmissions11/solmate",
    "storage-layout": "workspace:*",
    "viem": "catalog:"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  }
}
