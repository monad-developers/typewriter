{
  "name": "typewriter",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build ./src/index.ts ./src/client.ts --outdir dist --target bun --packages external --define globalThis.DEBUG=false --minify-syntax --sourcemap=linked",
    "test": "bun test --timeout 30000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "abipg": "workspace:*",
    "abitype": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "ox": "catalog:",
    "storage-layout": "workspace:*",
    "typewriter-evm": "workspace:*",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.3"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  }
}
