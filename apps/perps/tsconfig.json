{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": false,
    "baseUrl": ".",
    "paths": {
      "abipg": ["../../packages/abipg/src/index.ts"],
      "typewriter": ["../../packages/typewriter/src/index.ts"],
      "typewriter/client": ["../../packages/typewriter/src/client.ts"],
      "typewriter-evm": ["../../packages/typewriter-evm/src/index.ts"],
      "perps-sdk": ["./sdk/index.ts"],
      "storage-layout": ["../../packages/storage-layout/src/index.ts"]
    }
  }
}
