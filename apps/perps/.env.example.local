# Local development (Anvil)

# `bun dev` starts a local Anvil, deploys Perps to it with Anvil account #0 as
# the scheduler, claims the admin seat with a random key, lists every market,
# and starts a market maker. Every start is a new chain.

# Required — Postgres connection string.
DATABASE_URL=postgresql://ubuntu@localhost:5432/postgres

# Optional — the admin's secp256k1 key. Random in dev when unset.
# ADMIN_PRIVATE_KEY=0x...

# Optional — set either to 0 to stop that loop.
# ORACLE_INTERVAL_MS=1000
# FUNDING_INTERVAL_MS=10000

# Optional — set to false to start without the dev market maker.
# MARKET_MAKER=true

# Scripts
API_URL=http://localhost:3000
