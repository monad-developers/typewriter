# Required — deployer wallet private key (must be funded on target network)
DEPLOYER_PRIVATE_KEY=0x...

# Required — Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/orderbook

# Required — deployed token contract address
BUN_PUBLIC_TOKEN_ADDRESS=0x...

# Required — RPC endpoint URL
BUN_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz

# Required — chain ID
BUN_PUBLIC_CHAIN_ID=10143

# Required — deployed TokenFast contract address (deployer must be SCHEDULER)
BUN_PUBLIC_TOKEN_FAST_ADDRESS=0x...
