{
  "name": "token-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "forge build",
    "lint": "forge fmt --check",
    "deploy": ". .env && forge build && forge script ./script/Token.s.sol:TokenScript --broadcast --fork-url $RPC_URL --private-key $DEPLOYER_PRIVATE_KEY",
    "deploy:fast": ". .env && forge build && forge script ./script/TokenFast.s.sol:TokenFastScript --broadcast --fork-url $RPC_URL --private-key $DEPLOYER_PRIVATE_KEY",
    "dev": "{ sleep 1 && bun run deploy; } & anvil",
    "start": "bun run dev"
  },
  "dependencies": {
    "ds-test": "github:dapphub/ds-test",
    "forge-std": "github:foundry-rs/forge-std",
    "solmate": "github:transmissions11/solmate"
  }
}
