# Monad testnet

# Deployment

# Required for deploy and backend startup — deployer/scheduler private key.
# Must be funded on Monad testnet; it pays for every settlement transaction.
PRIVATE_KEY=0x...

# Backend

# Required for backend startup — Postgres connection string.
DATABASE_URL=postgresql://user:password@host:5432/pixelwar

# Public chain configuration

# Required for backend and scripts — deployed PixelWar contract address.
PIXEL_WAR_ADDRESS=0x...

# Required for backend and scripts — RPC endpoint URL.
# Use a comma-separated list to configure backend RPC failover.
RPC_URL=https://testnet-rpc.monad.xyz

# Required for backend and scripts — chain ID.
CHAIN_ID=10143

# Game clock

# Optional — how often the server signs AdvanceEpoch, refilling everyone's energy.
EPOCH_INTERVAL_MS=10000

# Abuse controls

# Optional — per-IP submission limits. The contract's energy cap is the durable
# limit; these keep one host from monopolising the queue on the server's dime.
RATE_LIMIT_PER_SECOND=25
RATE_LIMIT_BURST=60

# WebAuthn

# Required for passkey sign-in. Passkeys are bound to this hostname, so pick the
# final domain before players create credentials.
BUN_PUBLIC_RP_ID=pixel-war.up.railway.app
BUN_PUBLIC_ORIGIN=https://pixel-war.up.railway.app

# Participant scripts

# Required for scripts — running pixel-war backend URL.
API_URL=https://pixel-war.up.railway.app
