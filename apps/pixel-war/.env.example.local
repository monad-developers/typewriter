# Local development against anvil

# Deployment

# Required for deploy and backend startup — deployer/scheduler private key.
# This is anvil's first prefunded account.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Backend

# Required for backend startup — Postgres connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Public chain configuration

# Required for backend and scripts — deployed PixelWar contract address.
# `bun run deploy` prints this.
PIXEL_WAR_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Required for backend and scripts — RPC endpoint URL.
# Use a comma-separated list to configure backend RPC failover.
RPC_URL=http://localhost:8545

# Required for backend and scripts — chain ID.
CHAIN_ID=31337

# Game clock

# Optional — how often the server signs AdvanceEpoch, refilling everyone's energy.
EPOCH_INTERVAL_MS=10000

# WebAuthn

# Required for passkey sign-in — relying party ID and expected origin.
BUN_PUBLIC_RP_ID=localhost
BUN_PUBLIC_ORIGIN=http://localhost:3000

# Participant scripts

# Required for scripts — running pixel-war backend URL.
API_URL=http://localhost:3000
