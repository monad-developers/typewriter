{
  "name": "token",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "test": "bun test --timeout 60000",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "contracts:build": "forge build --root contracts --force",
    "contracts:lint": "forge fmt --check contracts && forge lint --root contracts",
    "deploy": ". .env && forge build --root contracts --force && forge script --root contracts ./contracts/script/Token.s.sol:TokenScript --broadcast --fork-url $BUN_PUBLIC_RPC_URL --private-key $DEPLOYER_PRIVATE_KEY"
  },
  "dependencies": {
    "@tanstack/react-query": "catalog:",
    "ffca": "workspace:*",
    "ox": "catalog:",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "storage-layout": "workspace:*",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "bun-plugin-tailwind": "0.1.2",
    "forge-std": "github:foundry-rs/forge-std#620536f",
    "prool": "catalog:",
    "tailwindcss": "4.2.2",
    "tw-animate-css": "1.4.0"
  }
}
