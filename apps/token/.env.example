# Postgres connection string used by Typewriter.
DATABASE_URL=postgresql://ubuntu@localhost:5432/postgres

# Without RPC_URL, `bun run dev` starts a local Anvil and deploys the token to
# it. Set all of the following to run against a deployed token instead; the
# deploy script also reads RPC_URL and PRIVATE_KEY.

# RPC endpoint for the app runtime and deploy script.
# RPC_URL=http://127.0.0.1:8545

# Chain ID used for typed-data signing.
# CHAIN_ID=31337

# Deployed token contract address.
# TOKEN_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Private key used by the scheduler account and Foundry deployment broadcast.
# PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
