# Monad testnet

# Deployment

# Required for deploy and backend startup — deployer wallet private key.
# Must be funded on Monad testnet.
PRIVATE_KEY=0x...

# Backend

# Required for backend startup — Postgres connection string.
DATABASE_URL=postgresql://ubuntu@localhost:5432/postgres

# Public chain configuration

# Required for backend and scripts — deployed OrderBook contract address.
ORDER_BOOK_ADDRESS=0xFe5855718EaF6048cBfEF7f2F700CA4cA0F0aA7a

# Required for backend and scripts — RPC endpoint URL.
# Use a comma-separated list to configure backend RPC failover.
RPC_URL=https://testnet-rpc.monad.xyz

# Required for backend and scripts — chain ID.
CHAIN_ID=10143

# WebAuthn

# Required for frontend sign-in — relying party ID.
BUN_PUBLIC_RP_ID=order-book.up.railway.app

# Required for frontend sign-in — expected origin.
BUN_PUBLIC_ORIGIN=https://order-book.up.railway.app

# Participant scripts

# Required for participant scripts — running order-book backend URL.
API_URL=https://order-book.up.railway.app
