# Monad testnet

# `bun run start` deploys the order book on the first start of a new
# DEPLOYMENT, seeds it, and resumes that deployment on later starts.

# Scheduler keys

# Required — address of the scheduler's root key, a separate cold key (e.g.
# AWS KMS) that never runs in the backend. The first start makes it the root
# credential, which signs scheduler credential changes out of band
# (scripts/scheduler-credential.ts).
ROOT_ADDRESS=0x...

# Required — the backend's hot key. The first start makes it an executor
# credential that never expires: it authorizes each settlement and, unless
# RELAYER_PRIVATE_KEY is set, sends it and pays its gas (and the deploy's).
# Must be funded on Monad testnet.
SCHEDULER_PRIVATE_KEY=0x...

# Optional — a separate funded key that sends settlements and pays their gas
# (and the deploy's), so rotating the scheduler key needs no gas transfer.
# RELAYER_PRIVATE_KEY=0x...

# Backend

# Required — Postgres connection string.
DATABASE_URL=postgresql://ubuntu@localhost:5432/postgres

# Required — the deployment's name: one contract and one database schema.
# A new name deploys a new order book; changing the contract needs one.
DEPLOYMENT=order_book_testnet_1

# Chain

# Required — RPC endpoint URL. Use a comma-separated list for failover.
RPC_URL=https://testnet-rpc.monad.xyz

# Required — chain ID. The backend refuses an RPC_URL on another chain.
CHAIN_ID=10143

# WebAuthn

# Required for frontend sign-in — relying party ID.
BUN_PUBLIC_RP_ID=order-book-demo.up.railway.app

# Required for frontend sign-in — expected origin.
BUN_PUBLIC_ORIGIN=https://order-book-demo.up.railway.app

# Participant scripts

# Required for participant scripts — running order-book backend URL.
API_URL=https://order-book-demo.up.railway.app
