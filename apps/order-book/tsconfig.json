{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": false,
    "baseUrl": ".",
    "paths": {
      "abipg": ["../../packages/abipg/src/index.ts"],
      "ffca": ["../../packages/ffca/src/index.ts"],
      "evm": ["../../packages/evm/src/index.ts"],
      "order-book-sdk": ["./sdk/index.ts"],
      "storage-layout": ["../../packages/storage-layout/src/index.ts"]
    }
  }
}
