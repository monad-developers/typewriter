{
  "name": "order-book",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "test": "bun test --timeout 60000",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "contracts:build": "forge build --root contracts",
    "contracts:lint": "forge fmt --check contracts && forge lint --root contracts",
    "deploy": ". .env && forge build --root contracts && forge script --root contracts ./contracts/script/OrderBook.s.sol:OrderBookScript --broadcast --fork-url $RPC_URL --private-key $PRIVATE_KEY"
  },
  "dependencies": {
    "@tanstack/react-query": "catalog:",
    "clsx": "2.1.1",
    "drizzle-orm": "1.0.0-rc.1",
    "effect": "catalog:",
    "typewriter": "workspace:*",
    "ox": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shiki": "4.5.0",
    "superjson": "catalog:",
    "tailwind-merge": "3.7.0",
    "viem": "catalog:",
    "webauthx": "0.1.2"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "bun-plugin-tailwind": "0.1.2",
    "forge-std": "github:foundry-rs/forge-std#620536f",
    "prool": "catalog:",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  }
}
