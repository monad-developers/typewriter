# Local development (Anvil)

# With RPC_URL unset, `bun dev` starts a local Anvil and deploys the order book
# to it, with Anvil account #0 as the scheduler. Every start is a new chain.

# Backend

# Required for backend startup — Postgres connection string.
DATABASE_URL=postgresql://ubuntu@localhost:5432/postgres

# Public chain configuration

# ORDER_BOOK_ADDRESS and CHAIN_ID stay unset: the backend reports its own
# deployment, and participant scripts read it from API_URL.

# WebAuthn

# Required for frontend sign-in — relying party ID.
BUN_PUBLIC_RP_ID=localhost

# Required for frontend sign-in — expected origin.
BUN_PUBLIC_ORIGIN=http://localhost:3000

# Participant scripts

# Required for participant scripts — running order-book backend URL.
API_URL=http://localhost:3000
