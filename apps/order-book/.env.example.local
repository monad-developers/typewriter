# Local development (Anvil)

# Required — deployer wallet private key (must be funded on target network)
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Required — scheduler EOA authorized to call Exchange.execute()
SCHEDULER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Required — Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Required — deployed Exchange contract address
BUN_PUBLIC_EXCHANGE_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Required — RPC endpoint URL
BUN_PUBLIC_RPC_URL=http://localhost:8545

# Required — chain ID
BUN_PUBLIC_CHAIN_ID=31337

# Required — WebAuthn relying party ID (your domain)
BUN_PUBLIC_RP_ID=localhost

# Required — WebAuthn expected origin
BUN_PUBLIC_ORIGIN=http://localhost:3000
