# Local development (Anvil)

# `bun dev` starts a local Anvil, deploys the order book to it with Anvil
# account #0 as the scheduler, and seeds the book. Every start is a new chain.

# Backend

# Required for backend startup — Postgres connection string.
DATABASE_URL=postgresql://ubuntu@localhost:5432/postgres

# WebAuthn

# Required for frontend sign-in — relying party ID.
BUN_PUBLIC_RP_ID=localhost

# Required for frontend sign-in — expected origin.
BUN_PUBLIC_ORIGIN=http://localhost:3000

# Participant scripts

# Required for participant scripts — running order-book backend URL.
API_URL=http://localhost:3000
