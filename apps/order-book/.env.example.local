# Local development (Anvil)

# Deployment

# Required for deploy and backend startup — deployer wallet private key.
# This is Anvil account #0.
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Required for deploy — scheduler EOA authorized to call Exchange.execute().
SCHEDULER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Backend

# Required for backend startup — Postgres connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Public chain configuration
# These BUN_PUBLIC_* values are exposed to the browser by bunfig.toml.

# Required for backend and frontend — deployed Exchange contract address.
BUN_PUBLIC_EXCHANGE_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Required for backend and frontend — RPC endpoint URL.
BUN_PUBLIC_RPC_URL=http://localhost:8545

# Required for backend and frontend — chain ID.
BUN_PUBLIC_CHAIN_ID=31337

# WebAuthn

# Required for frontend sign-in — relying party ID.
BUN_PUBLIC_RP_ID=localhost

# Required for frontend sign-in — expected origin.
BUN_PUBLIC_ORIGIN=http://localhost:3000

# Participant scripts

# Required for participant scripts — running order-book backend URL.
API_URL=http://localhost:3000

# Optional. Scripts fall back to BUN_PUBLIC_* and SCHEDULER_ADDRESS above for
# chain settings. Set these only for one-off overrides.
# CHAIN_ID=31337
# EXCHANGE_ADDRESS=0x5fbdb2315678afecb367f032d93f642f64180aa3
# RPC_URL=http://localhost:8545
